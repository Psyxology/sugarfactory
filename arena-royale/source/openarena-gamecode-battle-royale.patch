+/*
+================
+Battle royale zone helpers
+================
+*/
+void BG_BRParseZone( const char *s, brzone_t *z ) {
+	char *p = (char *)s;
+	int i;
+
+	memset( z, 0, sizeof( *z ) );
+	if ( !s || !s[0] ) {
+		return;
+	}
+	z->cx = atof( COM_Parse( &p ) );
+	z->cy = atof( COM_Parse( &p ) );
+	z->cz = atof( COM_Parse( &p ) );
+	z->minx = atof( COM_Parse( &p ) );
+	z->miny = atof( COM_Parse( &p ) );
+	z->maxx = atof( COM_Parse( &p ) );
+	z->maxy = atof( COM_Parse( &p ) );
+	z->numKeys = atoi( COM_Parse( &p ) );
+	if ( z->numKeys < 1 || z->numKeys > BR_MAX_KEYS ) {
+		z->numKeys = 0;
+		return;
+	}
+	for ( i = 0; i < z->numKeys; i++ ) {
+		z->t[i] = atoi( COM_Parse( &p ) );
+		z->r[i] = atof( COM_Parse( &p ) );
+	}
+	z->valid = qtrue;
+}
+
+float BG_BRZoneRadius( const brzone_t *z, int time ) {
+	int i;
+	float f;
+
+	if ( !z->valid ) {
+		return 999999;
+	}
+	if ( time <= z->t[0] ) {
+		return z->r[0];
+	}
+	for ( i = 1; i < z->numKeys; i++ ) {
+		if ( time < z->t[i] ) {
+			f = (float)( time - z->t[i-1] ) / (float)( z->t[i] - z->t[i-1] );
+			return z->r[i-1] + ( z->r[i] - z->r[i-1] ) * f;
+		}
+	}
+	return z->r[z->numKeys - 1];
+}
+
+// index of the next keyframe after time, or -1 when the zone has finished closing
+int BG_BRNextKey( const brzone_t *z, int time ) {
+	int i;
+
+	if ( !z->valid ) {
+		return -1;
+	}
+	for ( i = 0; i < z->numKeys; i++ ) {
+		if ( z->t[i] > time ) {
+			return i;
+		}
+	}
+	return -1;
+}
