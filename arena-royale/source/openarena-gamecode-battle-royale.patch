diff --git a/code/game/g_br.c b/code/game/g_br.c
new file mode 100644
index 0000000..f9acf9e
--- /dev/null
+++ b/code/game/g_br.c
@@ -0,0 +1,575 @@
+/*
+===========================================================================
+Battle royale mode (g_br 1)
+
+A free-for-all where nobody respawns. Players start with a gauntlet and a
+machinegun, loot the map, and a circular zone shrinks toward a random spot.
+Standing outside the zone hurts. The last player alive wins.
+
+This file is part of the OpenArena gamecode and is distributed under the
+GNU General Public License, version 2 or later.
+===========================================================================
+*/
+
+#include "g_local.h"
+
+#define BR_COUNTDOWN		12000	// ms of safe looting before the fighting starts
+#define BR_MAX_POINTS		1024
+
+static qboolean BR_IsSpawnClass( const char *cls ) {
+	return !Q_stricmp( cls, "info_player_deathmatch" ) || !Q_stricmp( cls, "info_player_start" )
+		|| !Q_stricmp( cls, "team_CTF_redspawn" ) || !Q_stricmp( cls, "team_CTF_bluespawn" )
+		|| !Q_stricmp( cls, "team_CTF_redplayer" ) || !Q_stricmp( cls, "team_CTF_blueplayer" );
+}
+
+static void BR_SetZoneString( void ) {
+	char buf[MAX_STRING_CHARS];
+	brzone_t *z = &level.brZone;
+	int i;
+
+	Com_sprintf( buf, sizeof( buf ), "%.0f %.0f %.0f %.0f %.0f %.0f %.0f %i",
+		z->cx, z->cy, z->cz, z->minx, z->miny, z->maxx, z->maxy, z->numKeys );
+	for ( i = 0; i < z->numKeys; i++ ) {
+		Q_strcat( buf, sizeof( buf ), va( " %i %.0f", z->t[i], z->r[i] ) );
+	}
+	trap_SetConfigstring( CS_BRZONE, buf );
+}
+
+/*
+================
+BR_PickZone
+
+Chooses the final zone center among the map's spawn points and items, near the
+middle of the map, and builds the shrink schedule.
+================
+*/
+static void BR_PickZone( void ) {
+	static vec3_t pts[BR_MAX_POINTS];
+	int n, i, pick, cands;
+	gentity_t *ent;
+	vec3_t mid, c;
+	float maxd, d, dx, dy, r0, pace;
+	brzone_t *z = &level.brZone;
+	int t;
+
+	n = 0;
+	for ( i = MAX_CLIENTS; i < level.num_entities && n < BR_MAX_POINTS; i++ ) {
+		ent = &g_entities[i];
+		if ( !ent->inuse || !ent->classname ) {
+			continue;
+		}
+		if ( ent->item || BR_IsSpawnClass( ent->classname ) ) {
+			VectorCopy( ent->s.origin, pts[n] );
+			n++;
+		}
+	}
+	if ( n == 0 ) {
+		return;
+	}
+
+	memset( z, 0, sizeof( *z ) );
+	z->minx = z->miny = 999999;
+	z->maxx = z->maxy = -999999;
+	VectorClear( mid );
+	for ( i = 0; i < n; i++ ) {
+		if ( pts[i][0] < z->minx ) z->minx = pts[i][0];
+		if ( pts[i][1] < z->miny ) z->miny = pts[i][1];
+		if ( pts[i][0] > z->maxx ) z->maxx = pts[i][0];
+		if ( pts[i][1] > z->maxy ) z->maxy = pts[i][1];
+		VectorAdd( mid, pts[i], mid );
+	}
+	VectorScale( mid, 1.0f / n, mid );
+
+	// how far the points spread from the middle
+	maxd = 0;
+	for ( i = 0; i < n; i++ ) {
+		dx = pts[i][0] - mid[0];
+		dy = pts[i][1] - mid[1];
+		d = sqrt( dx * dx + dy * dy );
+		if ( d > maxd ) maxd = d;
+	}
+
+	// pick a random point in the inner half of the map as the final center
+	cands = 0;
+	for ( i = 0; i < n; i++ ) {
+		dx = pts[i][0] - mid[0];
+		dy = pts[i][1] - mid[1];
+		if ( sqrt( dx * dx + dy * dy ) <= maxd * 0.45f ) {
+			cands++;
+		}
+	}
+	pick = cands ? rand() % cands : 0;
+	VectorCopy( pts[0], c );
+	for ( i = 0; i < n; i++ ) {
+		dx = pts[i][0] - mid[0];
+		dy = pts[i][1] - mid[1];
+		if ( cands && sqrt( dx * dx + dy * dy ) > maxd * 0.45f ) {
+			continue;
+		}
+		if ( pick-- == 0 ) {
+			VectorCopy( pts[i], c );
+			break;
+		}
+	}
+
+	// starting radius covers every point on the map
+	r0 = 0;
+	for ( i = 0; i < n; i++ ) {
+		dx = pts[i][0] - c[0];
+		dy = pts[i][1] - c[1];
+		d = sqrt( dx * dx + dy * dy );
+		if ( d > r0 ) r0 = d;
+	}
+	r0 += 384;
+
+	z->cx = c[0];
+	z->cy = c[1];
+	z->cz = c[2];
+	z->minx -= 256; z->miny -= 256;
+	z->maxx += 256; z->maxy += 256;
+
+	pace = g_brPace.value > 0.1f ? g_brPace.value : 1.0f;
+	t = level.brStartTime;
+#define BR_KEY(sec, rad) z->t[z->numKeys] = t + (int)( (sec) * 1000 * pace ); z->r[z->numKeys] = (rad); z->numKeys++;
+	BR_KEY( 0,   r0 );
+	BR_KEY( 30,  r0 );				// look around and loot
+	BR_KEY( 60,  r0 * 0.6f );		// first close
+	BR_KEY( 80,  r0 * 0.6f );
+	BR_KEY( 105, r0 * 0.32f );		// second close
+	BR_KEY( 120, r0 * 0.32f );
+	BR_KEY( 145, r0 * 0.12f );		// third close
+	BR_KEY( 155, r0 * 0.12f );
+	BR_KEY( 185, 0 );				// collapses completely
+#undef BR_KEY
+	z->valid = qtrue;
+	level.brCenterArea = 0;
+
+	BR_SetZoneString();
+}
+
+static vec3_t	brSpots[BR_MAX_POINTS];
+static int		brNumSpots;
+
+// every spawn point and item spot on the map is somewhere a player can start
+static void BR_FindSpots( void ) {
+	int i;
+	gentity_t *ent;
+
+	brNumSpots = 0;
+	for ( i = MAX_CLIENTS; i < level.num_entities && brNumSpots < BR_MAX_POINTS; i++ ) {
+		ent = &g_entities[i];
+		if ( !ent->inuse || !ent->classname ) {
+			continue;
+		}
+		if ( BR_IsSpawnClass( ent->classname ) || ( ent->item && !( ent->flags & FL_DROPPED_ITEM ) ) ) {
+			VectorCopy( ent->s.origin, brSpots[brNumSpots] );
+			brNumSpots++;
+		}
+	}
+}
+
+/*
+================
+BR_SelectSpawn
+
+Puts the player at the spot farthest from everyone else, with a little randomness.
+================
+*/
+void BR_SelectSpawn( gentity_t *ent, vec3_t origin, vec3_t angles ) {
+	int i, j, best[3], n;
+	float score[3], d, nearest;
+	vec3_t delta;
+	gclient_t *cl;
+
+	if ( brNumSpots == 0 ) {
+		return;
+	}
+	n = 0;
+	for ( i = 0; i < 3; i++ ) {
+		best[i] = -1;
+		score[i] = -1;
+	}
+	for ( i = 0; i < brNumSpots; i++ ) {
+		nearest = 999999;
+		for ( j = 0; j < level.maxclients; j++ ) {
+			cl = &level.clients[j];
+			if ( &g_entities[j] == ent || cl->pers.connected != CON_CONNECTED || cl->pers.brOut
+				|| cl->sess.sessionTeam == TEAM_SPECTATOR || g_entities[j].health <= 0 ) {
+				continue;
+			}
+			VectorSubtract( cl->ps.origin, brSpots[i], delta );
+			d = VectorLength( delta );
+			if ( d < nearest ) nearest = d;
+		}
+		nearest += random() * 200;
+		// keep the three best spots
+		for ( j = 0; j < 3; j++ ) {
+			if ( nearest > score[j] ) {
+				memmove( &score[j + 1], &score[j], sizeof( float ) * ( 2 - j ) );
+				memmove( &best[j + 1], &best[j], sizeof( int ) * ( 2 - j ) );
+				score[j] = nearest;
+				best[j] = i;
+				break;
+			}
+		}
+	}
+	for ( i = 0; i < 3; i++ ) {
+		if ( best[i] >= 0 ) n++;
+	}
+	if ( n == 0 ) {
+		return;
+	}
+	i = best[rand() % n];
+	VectorCopy( brSpots[i], origin );
+	origin[2] += 16;
+	VectorSet( angles, 0, random() * 360, 0 );
+}
+
+/*
+================
+BR_AddLoot
+
+Scatters extra weapons over the map's spawn points so there is enough to go round.
+================
+*/
+static void BR_AddLoot( void ) {
+	static const weapon_t loot[] = { WP_SHOTGUN, WP_SHOTGUN, WP_GRENADE_LAUNCHER, WP_ROCKET_LAUNCHER,
+		WP_LIGHTNING, WP_RAILGUN, WP_PLASMAGUN, WP_PLASMAGUN };
+	int i, count = 0;
+	gentity_t *spot, *it;
+	gitem_t *item;
+
+	for ( i = MAX_CLIENTS; i < level.num_entities; i++ ) {
+		spot = &g_entities[i];
+		if ( !spot->inuse || !spot->classname || !BR_IsSpawnClass( spot->classname ) ) {
+			continue;
+		}
+		item = BG_FindItemForWeapon( loot[rand() % ( sizeof( loot ) / sizeof( loot[0] ) )] );
+		if ( !item ) {
+			continue;
+		}
+		it = G_Spawn();
+		it->classname = item->classname;
+		VectorCopy( spot->s.origin, it->s.origin );
+		G_SpawnItem( it, item );
+		count++;
+	}
+	if ( count ) {
+		SaveRegisteredItems();
+	}
+}
+
+void BR_Init( void ) {
+	level.brStartTime = 0;
+	level.brEndTime = 0;
+	level.brWinner = -1;
+	level.brAlive = level.brTotal = 0;
+	level.brNextTick = 0;
+	level.brBotsAdded = qfalse;
+	level.brRestarting = qfalse;
+	memset( &level.brZone, 0, sizeof( level.brZone ) );
+
+	if ( !g_br.integer ) {
+		trap_SetConfigstring( CS_BRZONE, "" );
+		trap_SetConfigstring( CS_BRSTATE, "" );
+		return;
+	}
+
+	level.brStartTime = level.time + BR_COUNTDOWN;
+	BR_FindSpots();
+	BR_AddLoot();
+	BR_PickZone();
+	trap_SetConfigstring( CS_BRSTATE, va( "0 0 -1 %i", level.brStartTime ) );
+}
+
+static void BR_CountPlayers( int *alive, int *total, int *last ) {
+	int i;
+	gclient_t *cl;
+
+	*alive = *total = 0;
+	*last = -1;
+	for ( i = 0; i < level.maxclients; i++ ) {
+		cl = &level.clients[i];
+		if ( cl->pers.connected != CON_CONNECTED || cl->sess.sessionTeam == TEAM_SPECTATOR ) {
+			continue;
+		}
+		( *total )++;
+		if ( !cl->pers.brOut ) {
+			( *alive )++;
+			*last = i;
+		}
+	}
+}
+
+static int BR_ZoneDamage( float r ) {
+	float r0 = level.brZone.r[0];
+
+	if ( r0 <= 0 || r > r0 * 0.6f ) return 3;
+	if ( r > r0 * 0.3f ) return 6;
+	if ( r > r0 * 0.1f ) return 10;
+	return 15;
+}
+
+void BR_PlayerDied( gentity_t *self, gentity_t *attacker ) {
+	int alive, total, last;
+	const char *killer;
+
+	if ( !g_br.integer || !self->client || self->client->pers.brOut ) {
+		return;
+	}
+	if ( level.time < level.brStartTime || level.brEndTime ) {
+		return;		// still in the countdown, or already decided
+	}
+
+	BR_CountPlayers( &alive, &total, &last );
+	self->client->pers.brOut = qtrue;
+	self->client->pers.brPlace = alive;
+	self->client->pers.brOutTime = level.time;
+
+	if ( attacker && attacker->client && attacker != self ) {
+		killer = attacker->client->pers.netname;
+	} else {
+		killer = "the zone";
+	}
+
+	if ( !( self->r.svFlags & SVF_BOT ) ) {
+		trap_SendServerCommand( self - g_entities, va( "brout %i %i \"%s\"", alive, total, killer ) );
+	}
+	if ( alive - 1 > 1 ) {
+		trap_SendServerCommand( -1, va( "print \"%s" S_COLOR_WHITE " was knocked out. %i left.\n\"",
+			self->client->pers.netname, alive - 1 ) );
+	}
+}
+
+qboolean BR_BlockRespawn( gentity_t *ent ) {
+	return g_br.integer && ent->client && ent->client->pers.brOut;
+}
+
+void BR_SpawnLoadout( gclient_t *client ) {
+	int i;
+
+	for ( i = 0; i < MAX_WEAPONS; i++ ) {
+		client->ps.ammo[i] = 0;
+	}
+	client->ps.stats[STAT_WEAPONS] = ( 1 << WP_GAUNTLET ) | ( 1 << WP_MACHINEGUN );
+	client->ps.ammo[WP_GAUNTLET] = -1;
+	client->ps.ammo[WP_MACHINEGUN] = 20;
+	client->ps.stats[STAT_HEALTH] = 100;
+	client->ps.stats[STAT_ARMOR] = 0;
+}
+
+static void BR_AddBots( void ) {
+	char names[MAX_STRING_CHARS], *p, *tok;
+	char list[32][MAX_NETNAME];
+	int i, j, n, bots = 0, want;
+	char tmp[MAX_NETNAME];
+	char clean[MAX_NETNAME];
+
+	for ( i = 0; i < level.maxclients; i++ ) {
+		if ( level.clients[i].pers.connected != CON_DISCONNECTED && ( g_entities[i].r.svFlags & SVF_BOT ) ) {
+			bots++;
+		}
+	}
+	want = g_brBots.integer;
+	if ( want > level.maxclients - 2 ) {
+		want = level.maxclients - 2;
+	}
+	if ( bots >= want ) {
+		return;
+	}
+
+	// shuffled roster, skipping bots already in the game
+	trap_Cvar_VariableStringBuffer( "g_brBotNames", names, sizeof( names ) );
+	n = 0;
+	p = names;
+	while ( n < 32 ) {
+		tok = COM_Parse( &p );
+		if ( !tok[0] ) {
+			break;
+		}
+		for ( j = 0; j < level.maxclients; j++ ) {
+			if ( level.clients[j].pers.connected == CON_DISCONNECTED ) continue;
+			Q_strncpyz( clean, level.clients[j].pers.netname, sizeof( clean ) );
+			Q_CleanStr( clean );
+			if ( !Q_stricmp( clean, tok ) ) break;
+		}
+		if ( j < level.maxclients ) {
+			continue;
+		}
+		Q_strncpyz( list[n], tok, sizeof( list[n] ) );
+		n++;
+	}
+	for ( i = n - 1; i > 0; i-- ) {
+		j = rand() % ( i + 1 );
+		Q_strncpyz( tmp, list[i], sizeof( tmp ) );
+		Q_strncpyz( list[i], list[j], sizeof( list[i] ) );
+		Q_strncpyz( list[j], tmp, sizeof( list[j] ) );
+	}
+	for ( i = 0; bots < want; i++, bots++ ) {
+		if ( i < n ) {
+			trap_SendConsoleCommand( EXEC_APPEND, va( "addbot %s %i\n", list[i], g_brBotSkill.integer ) );
+		} else {
+			trap_SendConsoleCommand( EXEC_APPEND, va( "addbot random %i\n", g_brBotSkill.integer ) );
+		}
+	}
+}
+
+static int BR_PickFollowTarget( int current ) {
+	int i, c;
+
+	for ( i = 1; i <= level.maxclients; i++ ) {
+		c = ( current + i + level.maxclients ) % level.maxclients;
+		if ( level.clients[c].pers.connected == CON_CONNECTED && !level.clients[c].pers.brOut
+			&& level.clients[c].sess.sessionTeam != TEAM_SPECTATOR ) {
+			return c;
+		}
+	}
+	return -1;
+}
+
+/*
+================
+BR_UpdateSpectators
+
+A knocked-out human watches whoever is still standing. When a new match
+starts they are put back into the game.
+================
+*/
+static void BR_UpdateSpectators( void ) {
+	int i, target;
+	gentity_t *ent;
+	gclient_t *cl;
+
+	for ( i = 0; i < level.maxclients; i++ ) {
+		ent = &g_entities[i];
+		cl = &level.clients[i];
+		if ( !ent->inuse || cl->pers.connected != CON_CONNECTED || ( ent->r.svFlags & SVF_BOT ) ) {
+			continue;
+		}
+		// back into the game for a fresh match
+		if ( cl->sess.sessionTeam == TEAM_SPECTATOR && !cl->pers.brOut && level.time < level.brStartTime - 1500 ) {
+			SetTeam( ent, "free" );
+			continue;
+		}
+		if ( !cl->pers.brOut ) {
+			continue;
+		}
+		if ( cl->sess.sessionTeam != TEAM_SPECTATOR ) {
+			if ( level.time > cl->pers.brOutTime + 2500 && BR_PickFollowTarget( i ) >= 0 ) {
+				cl->pers.brSpectating = qtrue;
+				SetTeam( ent, "spectator" );
+			}
+			continue;
+		}
+		// keep following someone who is still standing
+		target = cl->sess.spectatorClient;
+		if ( cl->sess.spectatorState != SPECTATOR_FOLLOW || target < 0 || target >= level.maxclients
+			|| level.clients[target].pers.brOut || level.clients[target].pers.connected != CON_CONNECTED ) {
+			target = BR_PickFollowTarget( target < 0 ? i : target );
+			if ( target >= 0 ) {
+				cl->sess.spectatorState = SPECTATOR_FOLLOW;
+				cl->sess.spectatorClient = target;
+			}
+		}
+	}
+}
+
+void BR_RunFrame( void ) {
+	int i, alive, total, last, dmg;
+	float r, dx, dy;
+	gentity_t *ent;
+	gclient_t *cl;
+	char state[64];
+	static char lastState[64];
+
+	if ( !g_br.integer || !level.brZone.valid ) {
+		return;
+	}
+
+	// wait until clients have (re)connected; after map_restart they rejoin after the first frames
+	if ( !level.brBotsAdded && level.time - level.startTime > 1500 ) {
+		level.brBotsAdded = qtrue;
+		BR_AddBots();
+	}
+
+	BR_CountPlayers( &alive, &total, &last );
+
+	if ( level.time >= level.brStartTime && !level.brEndTime && level.brTotal == 0 && total > 1 ) {
+		level.brTotal = total;
+		trap_SendServerCommand( -1, "cp \"" S_COLOR_YELLOW "GO!\n" S_COLOR_WHITE "Last one standing wins\"" );
+	}
+
+	// decide the winner
+	if ( level.brTotal && !level.brEndTime && alive <= 1 ) {
+		level.brEndTime = level.time;
+		level.brWinner = last;
+		if ( last >= 0 ) {
+			level.clients[last].pers.brPlace = 1;
+			trap_SendServerCommand( -1, va( "print \"%s" S_COLOR_WHITE " is the last one standing!\n\"",
+				level.clients[last].pers.netname ) );
+		}
+	}
+
+	Com_sprintf( state, sizeof( state ), "%i %i %i %i", alive, level.brTotal ? level.brTotal : total,
+		level.brWinner, level.brStartTime );
+	if ( strcmp( state, lastState ) ) {
+		Q_strncpyz( lastState, state, sizeof( lastState ) );
+		trap_SetConfigstring( CS_BRSTATE, state );
+	}
+
+	// hurt everyone outside the zone once a second
+	if ( level.brTotal && !level.brEndTime && level.time >= level.brNextTick ) {
+		level.brNextTick = level.time + 1000;
+		r = BG_BRZoneRadius( &level.brZone, level.time );
+		dmg = BR_ZoneDamage( r );
+		for ( i = 0; i < level.maxclients; i++ ) {
+			ent = &g_entities[i];
+			cl = &level.clients[i];
+			if ( !ent->inuse || cl->pers.connected != CON_CONNECTED || cl->pers.brOut
+				|| cl->sess.sessionTeam == TEAM_SPECTATOR || ent->health <= 0 ) {
+				continue;
+			}
+			dx = cl->ps.origin[0] - level.brZone.cx;
+			dy = cl->ps.origin[1] - level.brZone.cy;
+			if ( dx * dx + dy * dy > r * r ) {
+				G_Damage( ent, NULL, NULL, NULL, NULL, dmg, DAMAGE_NO_ARMOR | DAMAGE_NO_PROTECTION, MOD_TRIGGER_HURT );
+			}
+		}
+	}
+
+	// developer readout of where everyone is relative to the zone
+	if ( trap_Cvar_VariableIntegerValue( "g_brDebug" ) && level.time % 10000 < 50 ) {
+		r = BG_BRZoneRadius( &level.brZone, level.time );
+		G_Printf( "BRDBG t=%i r=%.0f", ( level.time - level.brStartTime ) / 1000, r );
+		for ( i = 0; i < level.maxclients; i++ ) {
+			cl = &level.clients[i];
+			if ( cl->pers.connected != CON_CONNECTED || cl->pers.brOut ) continue;
+			dx = cl->ps.origin[0] - level.brZone.cx;
+			dy = cl->ps.origin[1] - level.brZone.cy;
+			G_Printf( " %s=%.0f", cl->pers.netname, sqrt( dx * dx + dy * dy ) );
+		}
+		G_Printf( "\n" );
+	}
+
+	BR_UpdateSpectators();
+
+	// a human who is out (or the match is over) clicks fire to start a new match
+	if ( !level.brRestarting ) {
+		for ( i = 0; i < level.maxclients; i++ ) {
+			ent = &g_entities[i];
+			cl = &level.clients[i];
+			if ( !ent->inuse || cl->pers.connected != CON_CONNECTED || ( ent->r.svFlags & SVF_BOT ) ) {
+				continue;
+			}
+			if ( level.time - cl->pers.brAttackTime > 150 ) {
+				continue;
+			}
+			if ( ( cl->pers.brOut && level.time > cl->pers.brOutTime + 2500 )
+				|| ( level.brEndTime && level.time > level.brEndTime + 2500 ) ) {
+				level.brRestarting = qtrue;
+				trap_SendConsoleCommand( EXEC_APPEND, "map_restart 0\n" );
+				break;
+			}
+		}
+	}
+}
