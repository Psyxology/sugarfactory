diff --git a/code/cgame/cg_br.c b/code/cgame/cg_br.c
new file mode 100644
index 0000000..3c73cb3
--- /dev/null
+++ b/code/cgame/cg_br.c
@@ -0,0 +1,277 @@
+/*
+===========================================================================
+Battle royale HUD: zone wall, minimap, players left, and the end screens.
+
+This file is part of the OpenArena gamecode and is distributed under the
+GNU General Public License, version 2 or later.
+===========================================================================
+*/
+
+#include "cg_local.h"
+
+#define BR_WALL_SEGMENTS	48
+#define BR_WALL_ROWS		3
+#define BR_WALL_ROWHEIGHT	512
+
+void CG_BR_ParseZone( void ) {
+	BG_BRParseZone( CG_ConfigString( CS_BRZONE ), &cgs.br );
+}
+
+void CG_BR_ParseState( void ) {
+	const char *s = CG_ConfigString( CS_BRSTATE );
+	char *p = (char *)s;
+
+	if ( !s[0] ) {
+		cgs.brAlive = cgs.brTotal = cgs.brStartTime = 0;
+		cgs.brWinner = -1;
+		return;
+	}
+	cgs.brAlive = atoi( COM_Parse( &p ) );
+	cgs.brTotal = atoi( COM_Parse( &p ) );
+	cgs.brWinner = atoi( COM_Parse( &p ) );
+	cgs.brStartTime = atoi( COM_Parse( &p ) );
+}
+
+// "brout <place> <total> <killer>" is sent to a player when they are knocked out
+void CG_BR_Out( void ) {
+	cg.brPlace = atoi( CG_Argv( 1 ) );
+	cg.brOutTotal = atoi( CG_Argv( 2 ) );
+	Q_strncpyz( cg.brKiller, CG_Argv( 3 ), sizeof( cg.brKiller ) );
+	cg.brOutTime = cg.time;
+}
+
+void CG_BR_Reset( void ) {
+	cg.brPlace = 0;
+	cg.brOutTime = 0;
+	cg.brKiller[0] = 0;
+}
+
+/*
+================
+CG_BR_AddZoneWall
+
+A glowing see-through wall standing on the zone's edge.
+================
+*/
+void CG_BR_AddZoneWall( void ) {
+	polyVert_t verts[4];
+	float r, a0, a1, c0, s0, c1, s1, z0, z1, d, glow, dx, dy;
+	int i, j, k;
+	byte shade[4];
+	vec3_t eye;
+
+	if ( !cgs.br.valid || !cgs.media.brZoneShader ) {
+		return;
+	}
+	r = BG_BRZoneRadius( &cgs.br, cg.time );
+	if ( r < 8 ) {
+		return;
+	}
+
+	VectorCopy( cg.refdef.vieworg, eye );
+	dx = eye[0] - cgs.br.cx;
+	dy = eye[1] - cgs.br.cy;
+	d = sqrt( dx * dx + dy * dy );
+	// brightest when you are close to the edge, faint from deep inside
+	glow = 1.0f - fabs( d - r ) / 1200.0f;
+	if ( glow < 0.12f ) glow = 0.12f;
+	glow *= 0.8f;
+
+	shade[0] = (byte)( 90 * glow );
+	shade[1] = (byte)( 150 * glow );
+	shade[2] = (byte)( 255 * glow );
+	shade[3] = 255;
+
+	for ( i = 0; i < BR_WALL_SEGMENTS; i++ ) {
+		a0 = ( 2 * M_PI * i ) / BR_WALL_SEGMENTS;
+		a1 = ( 2 * M_PI * ( i + 1 ) ) / BR_WALL_SEGMENTS;
+		c0 = cos( a0 ); s0 = sin( a0 );
+		c1 = cos( a1 ); s1 = sin( a1 );
+		for ( j = 0; j < BR_WALL_ROWS; j++ ) {
+			z0 = eye[2] - BR_WALL_ROWHEIGHT * BR_WALL_ROWS / 2 + j * BR_WALL_ROWHEIGHT;
+			z1 = z0 + BR_WALL_ROWHEIGHT;
+
+			VectorSet( verts[0].xyz, cgs.br.cx + c0 * r, cgs.br.cy + s0 * r, z0 );
+			VectorSet( verts[1].xyz, cgs.br.cx + c1 * r, cgs.br.cy + s1 * r, z0 );
+			VectorSet( verts[2].xyz, cgs.br.cx + c1 * r, cgs.br.cy + s1 * r, z1 );
+			VectorSet( verts[3].xyz, cgs.br.cx + c0 * r, cgs.br.cy + s0 * r, z1 );
+
+			verts[0].st[0] = a0 * r / 256.0f; verts[0].st[1] = z0 / 256.0f;
+			verts[1].st[0] = a1 * r / 256.0f; verts[1].st[1] = z0 / 256.0f;
+			verts[2].st[0] = a1 * r / 256.0f; verts[2].st[1] = z1 / 256.0f;
+			verts[3].st[0] = a0 * r / 256.0f; verts[3].st[1] = z1 / 256.0f;
+
+			for ( k = 0; k < 4; k++ ) {
+				verts[k].modulate[0] = shade[0];
+				verts[k].modulate[1] = shade[1];
+				verts[k].modulate[2] = shade[2];
+				verts[k].modulate[3] = shade[3];
+			}
+			trap_R_AddPolyToScene( cgs.media.brZoneShader, 4, verts );
+		}
+	}
+}
+
+static void CG_BR_Dot( float x, float y, float size, const float *color ) {
+	CG_FillRect( x - size / 2, y - size / 2, size, size, color );
+}
+
+static void CG_BR_DrawCircle( float mx, float my, float scale, float wx, float wy, float r,
+	float bx, float by, float bsize, const float *color ) {
+	int i, n;
+	float a, x, y;
+
+	n = 64;
+	for ( i = 0; i < n; i++ ) {
+		a = 2 * M_PI * i / n;
+		x = mx + ( wx + cos( a ) * r ) * scale;
+		y = my - ( wy + sin( a ) * r ) * scale;
+		if ( x < bx || x > bx + bsize || y < by || y > by + bsize ) {
+			continue;
+		}
+		CG_BR_Dot( x, y, 1.5f, color );
+	}
+}
+
+/*
+================
+CG_BR_DrawMinimap
+
+North-up map of the zone with your position, in the top right corner.
+================
+*/
+static void CG_BR_DrawMinimap( void ) {
+	static const float bg[4] = { 0, 0, 0, 0.45f };
+	static const float edge[4] = { 1, 1, 1, 0.25f };
+	static const float zoneColor[4] = { 0.4f, 0.7f, 1, 1 };
+	static const float nextColor[4] = { 1, 1, 1, 0.8f };
+	static const float meColor[4] = { 1, 0.85f, 0.1f, 1 };
+	float size = 104, bx = 640 - size - 6, by = 6;
+	float w, h, scale, mx, my, px, py, r, yaw;
+	int k, i;
+
+	w = cgs.br.maxx - cgs.br.minx;
+	h = cgs.br.maxy - cgs.br.miny;
+	if ( w < 1 || h < 1 ) {
+		return;
+	}
+	scale = size / ( w > h ? w : h );
+	// screen position of world (0,0), with the map centered in the box
+	mx = bx + size / 2 - ( cgs.br.minx + w / 2 ) * scale;
+	my = by + size / 2 + ( cgs.br.miny + h / 2 ) * scale;
+
+	CG_FillRect( bx, by, size, size, bg );
+	CG_FillRect( bx, by, size, 1, edge );
+	CG_FillRect( bx, by + size - 1, size, 1, edge );
+	CG_FillRect( bx, by, 1, size, edge );
+	CG_FillRect( bx + size - 1, by, 1, size, edge );
+
+	r = BG_BRZoneRadius( &cgs.br, cg.time );
+	CG_BR_DrawCircle( mx, my, scale, cgs.br.cx, cgs.br.cy, r, bx, by, size, zoneColor );
+	k = BG_BRNextKey( &cgs.br, cg.time );
+	if ( k >= 0 && cgs.br.r[k] < r - 1 ) {
+		CG_BR_DrawCircle( mx, my, scale, cgs.br.cx, cgs.br.cy, cgs.br.r[k], bx, by, size, nextColor );
+	}
+
+	px = mx + cg.refdef.vieworg[0] * scale;
+	py = my - cg.refdef.vieworg[1] * scale;
+	if ( px < bx ) px = bx;
+	if ( px > bx + size ) px = bx + size;
+	if ( py < by ) py = by;
+	if ( py > by + size ) py = by + size;
+	yaw = DEG2RAD( cg.refdefViewAngles[YAW] );
+	for ( i = 1; i <= 4; i++ ) {
+		CG_BR_Dot( px + cos( yaw ) * i * 2.5f, py - sin( yaw ) * i * 2.5f, 1.5f, meColor );
+	}
+	CG_BR_Dot( px, py, 4, meColor );
+}
+
+static const char *CG_BR_Ordinal( int n ) {
+	if ( n % 100 >= 11 && n % 100 <= 13 ) return va( "%ith", n );
+	switch ( n % 10 ) {
+	case 1: return va( "%ist", n );
+	case 2: return va( "%ind", n );
+	case 3: return va( "%ird", n );
+	default: return va( "%ith", n );
+	}
+}
+
+void CG_BR_Draw2D( void ) {
+	static vec4_t white = { 1, 1, 1, 1 };
+	static vec4_t yellow = { 1, 0.85f, 0.2f, 1 };
+	static vec4_t red = { 1, 0.3f, 0.25f, 1 };
+	static vec4_t shade = { 0, 0, 0, 0.55f };
+	float r, dx, dy, d;
+	int k, secs, me;
+	const char *s;
+	qboolean won, out;
+
+	if ( !cgs.br.valid || !cg.snap ) {
+		return;
+	}
+	me = cg.clientNum;
+
+	CG_BR_DrawMinimap();
+
+	// players left
+	if ( cgs.brTotal ) {
+		s = va( "%i LEFT", cgs.brAlive );
+		UI_DrawProportionalString( 640 - 58, 114, s, UI_CENTER | UI_SMALLFONT | UI_DROPSHADOW, white );
+	}
+
+	// zone timer
+	r = BG_BRZoneRadius( &cgs.br, cg.time );
+	k = BG_BRNextKey( &cgs.br, cg.time );
+	if ( cg.time < cgs.brStartTime ) {
+		secs = ( cgs.brStartTime - cg.time + 999 ) / 1000;
+		UI_DrawProportionalString( 320, 120, va( "FIGHTING STARTS IN %i", secs ), UI_CENTER | UI_DROPSHADOW, yellow );
+		UI_DrawProportionalString( 320, 146, "Grab a weapon! Nobody can get hurt yet.", UI_CENTER | UI_SMALLFONT | UI_DROPSHADOW, white );
+	} else if ( k >= 0 && cgs.brWinner < 0 ) {
+		if ( k > 0 && cgs.br.r[k] < cgs.br.r[k-1] ) {
+			s = "ZONE CLOSING";
+		} else {
+			secs = ( cgs.br.t[k] - cg.time + 999 ) / 1000;
+			s = va( "ZONE CLOSES IN %i:%02i", secs / 60, secs % 60 );
+		}
+		UI_DrawProportionalString( 640 - 58, 134, s, UI_CENTER | UI_SMALLFONT | UI_DROPSHADOW, yellow );
+	}
+
+	won = ( cgs.brWinner >= 0 && cgs.brWinner == me );
+	out = ( cg.brPlace > 0 );
+
+	// outside warning
+	if ( !won && !out && cg.snap->ps.stats[STAT_HEALTH] > 0 && cg.time >= cgs.brStartTime ) {
+		dx = cg.refdef.vieworg[0] - cgs.br.cx;
+		dy = cg.refdef.vieworg[1] - cgs.br.cy;
+		d = sqrt( dx * dx + dy * dy );
+		if ( d > r && ( cg.time / 400 ) % 2 ) {
+			UI_DrawProportionalString( 320, 300, "OUTSIDE THE ZONE! GET BACK IN", UI_CENTER | UI_DROPSHADOW, red );
+		}
+	}
+
+	// once you are out and watching the others, shrink to a banner
+	if ( out && !won && cgs.brWinner < 0 && cg.time > cg.brOutTime + 6000 ) {
+		CG_FillRect( 0, 52, 640, 44, shade );
+		UI_DrawProportionalString( 320, 56, va( "YOU PLACED %s", CG_BR_Ordinal( cg.brPlace ) ), UI_CENTER | UI_DROPSHADOW, red );
+		UI_DrawProportionalString( 320, 78, "Watching the rest of the match. Click to play again.", UI_CENTER | UI_SMALLFONT | UI_DROPSHADOW, white );
+		return;
+	}
+
+	// end screens
+	if ( won || out || cgs.brWinner >= 0 ) {
+		CG_FillRect( 0, 150, 640, 150, shade );
+		if ( won ) {
+			UI_DrawProportionalString( 320, 170, "YOU WIN!", UI_CENTER | UI_GIANTFONT | UI_DROPSHADOW, yellow );
+			UI_DrawProportionalString( 320, 220, va( "Last one standing out of %i", cgs.brTotal ), UI_CENTER | UI_DROPSHADOW, white );
+		} else if ( out ) {
+			UI_DrawProportionalString( 320, 170, va( "YOU PLACED %s", CG_BR_Ordinal( cg.brPlace ) ), UI_CENTER | UI_GIANTFONT | UI_DROPSHADOW, red );
+			UI_DrawProportionalString( 320, 220, va( "Knocked out by %s", cg.brKiller ), UI_CENTER | UI_DROPSHADOW, white );
+		} else {
+			UI_DrawProportionalString( 320, 170, "MATCH OVER", UI_CENTER | UI_GIANTFONT | UI_DROPSHADOW, yellow );
+			UI_DrawProportionalString( 320, 220, va( "%s won", cgs.clientinfo[cgs.brWinner].name ), UI_CENTER | UI_DROPSHADOW, white );
+		}
+		if ( ( out && cg.time > cg.brOutTime + 2500 ) || ( !out && cgs.brWinner >= 0 ) ) {
+			UI_DrawProportionalString( 320, 262, "Click to play again", UI_CENTER | UI_SMALLFONT | UI_DROPSHADOW, white );
+		}
+	}
+}
